{
  "name": "Interfayce Index default",
  "app_key": "com.lag0matic.interfayce",
  "controller_type": "knuckles",
  "description": "B-button double-tap and hold for playspace drag; right grip grabs desktop frames.",
  "options": {},
  "simulated_actions": [],
  "bindings": {
    "/actions/interfayce": {
      "haptics": [
        {
          "output": "/actions/interfayce/out/left_haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/interfayce/out/right_haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/interfayce/in/left_pointer_pose",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/interfayce/in/right_pointer_pose",
          "path": "/user/hand/right/pose/tip"
        }
      ],
      "sources": [
        {
          "path": "/user/hand/left/input/b",
          "mode": "button",
          "inputs": {
            "double": {
              "output": "/actions/interfayce/in/left_drag"
            }
          }
        },
        {
          "path": "/user/hand/right/input/b",
          "mode": "button",
          "inputs": {
            "double": {
              "output": "/actions/interfayce/in/right_drag"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/interfayce/in/left_ui_click"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trigger",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/interfayce/in/right_ui_click"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "button",
          "parameters": {
            "force_input": "force",
            "click_activate_threshold": "0.70",
            "click_deactivate_threshold": "0.50",
            "haptic_amplitude": "0"
          },
          "inputs": {
            "click": {
              "output": "/actions/interfayce/in/left_surface_grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/grip",
          "mode": "button",
          "parameters": {
            "force_input": "force",
            "click_activate_threshold": "0.70",
            "click_deactivate_threshold": "0.50",
            "haptic_amplitude": "0"
          },
          "inputs": {
            "click": {
              "output": "/actions/interfayce/in/right_surface_grab"
            }
          }
        },
        {
          "path": "/user/hand/right/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "position": {
              "output": "/actions/interfayce/in/right_surface_scroll"
            }
          }
        },
        {
          "path": "/user/hand/right/input/trackpad",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/interfayce/in/right_secondary_click"
            }
          }
        }
      ]
    }
  }
}
